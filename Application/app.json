{
  "expo": {
    "name": "Gym Go",
    "slug": "GymGO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/5.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.GymGo",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "reactNativeArchitectures": "arm64-v8a",
            "ndkVersion": "26.1.10909125"
          }
        }
      ],
      "expo-health-connect",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1498623250201325~4395450311",
          "iosAppId": "ca-app-pub-1498623250201325~4395450311"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.GymGo"
    },
    "web": {
      "favicon": "./assets/2.png"
    },
    "extra": {
      "eas": {
        "projectId": "fbebdf3d-75b0-4e53-af31-307ef5d54546"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbebdf3d-75b0-4e53-af31-307ef5d54546"
    }
  }

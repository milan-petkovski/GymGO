{
  "expo": {
    "name": "Gym Go",
    "slug": "Gym Go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/5.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "reactNativeArchitectures": "arm64-v8a",
            "ndkVersion": "26.1.10909125"
          }
        }
      ],
      "expo-health-connect",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1498623250201325~4395450311",
          "android_app_id": "ca-app-pub-1498623250201325~4395450311",
          "iosAppId": "ca-app-pub-1498623250201325~4395450311",
          "ios_app_id": "ca-app-pub-1498623250201325~4395450311"
        }
      ]
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/2.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.GymGo"
    },
    "web": {
      "favicon": "./assets/2.png"
    },
    "extra": {
      "react-native-google-mobile-ads": {
        "android_app_id": "ca-app-pub-1498623250201325~4395450311",
        "ios_app_id": "ca-app-pub-1498623250201325~4395450311"
      }
    }
  }
}